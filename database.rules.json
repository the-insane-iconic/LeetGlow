{
  "rules": {
    "rooms": {
      "$code": {
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('creatorId').val() === auth.uid || !data.hasChild('creatorId'))"
        },
        "members": {
          ".read": "auth != null",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId"
          }
        }
      }
    },
    "public_rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      "$cycle": {
        ".read": "auth != null",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    }
  }
}

