{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_title": "LeetGlow - Custom Themes & Backgrounds"
   },
   "author": "AnshYadav",
   "background": {
      "service_worker": "src/background.js"
   },
   "commands": {
      "toggle-focus": {
         "description": "Anime Studio: toggle focus mode (hide the scene and moments)",
         "suggested_key": {
            "default": "Ctrl+Shift+Period",
            "mac": "Command+Shift+Period"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": false,
      "css": [ "themes/core.css", "themes/paper.css", "themes/sakura.css", "themes/grid.css", "themes/orchid.css", "themes/anime.css", "themes/crawler.css", "themes/game.css", "themes/pixel.css" ],
      "js": [ "src/content.js", "src/problem.js", "src/anime/scenes.js", "src/anime/css.js", "src/anime/anime.js", "src/monaco-ink.js", "src/sheet-scroll.js", "src/verdict.js", "src/share.js", "src/anime/moments-ui.js", "src/anime/sounds.js", "src/anime/moments.js", "src/game/petals.js", "src/game/sounds.js", "src/game/title-card.js", "src/game/game.js", "src/game/icons.js", "src/game/ambient.js", "src/game/result.js", "src/pixel/sprites.js", "src/pixel/pixel.js" ],
      "matches": [ "https://leetcode.com/problems/*", "https://leetcode.cn/problems/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": false,
      "js": [ "src/net-verdict.js", "src/inject.js" ],
      "matches": [ "https://leetcode.com/problems/*", "https://leetcode.cn/problems/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   } ],
   "description": "Custom LeetCode themes and dark mode for the code editor and problem page. Set any picture or anime scene as your background.",
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "host_permissions": [
      "https://*.supabase.co/*",
      "https://*.razorpay.com/*"
   ],
   "manifest_version": 3,
   "name": "LeetGlow - Custom Themes, Sound Effects & Backgrounds",
   "permissions": [ "storage", "offscreen", "sidePanel" ],
   "short_name": "LeetGlow",
   "side_panel": {
      "default_path": "src/popup.html"
   },
   "version": "3.6.5",
   "web_accessible_resources": [ {
      "matches": [ "https://leetcode.com/*", "https://leetcode.cn/*" ],
      "resources": [ "fonts/*.woff2", "audio/anime/*", "audio/crawler/*", "textures/*", "textures/anime/*", "textures/game/*", "textures/game/icon/*", "sounds/game/*" ]
   } ]
}
